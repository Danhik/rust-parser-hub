# Local sessions (cookies for Tradeit/Skinswap)
parsers/*_session_*.json

# Proxy lists (contains usernames/passwords)
parsers/proxies.txt
parsers/*.txt

# Local configuration
config.json

# IDE config
.vscode/
.idea/
